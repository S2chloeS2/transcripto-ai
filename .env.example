# TranscriptoAI 설정
# 이 파일은 gitignore 되어 있습니다. 절대 커밋하지 마세요.

# ── 필수 ──────────────────────────────────────────
# 요약 · 키워드 설명 · AI 챗에 사용
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-여기에키

# ── 전사 (권장) ───────────────────────────────────
# 미팅 화자 분리 + whisper 대비 절반 이하 가격
# https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=여기에키

# ── 전사 (선택) ───────────────────────────────────
# 강의용 최저가 엔진. 없으면 위의 것으로 자동 폴백
# https://console.groq.com/keys
# GROQ_API_KEY=

# ── 로그인 ────────────────────────────────────────
# console.cloud.google.com → 사용자 인증 정보 → OAuth 클라이언트 ID (웹)
# 승인된 리디렉션 URI: http://127.0.0.1:5001/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 세션 쿠키 서명용. 없으면 재시작마다 로그아웃됩니다.
# 생성: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# 구글 설정 전까지 로컬에서 쓰기 위한 임시 로그인 (배포에서는 무시됨)
# ALLOW_DEV_LOGIN=1

# ── 돈 잠금장치 (배포 시 반드시) ────────────────────
# 허용한 구글 계정만 로그인. 비우면 누구나 가입 (= 누구나 네 API 비용을 씀)
ALLOWED_EMAILS=cats1520@gmail.com
# ALLOWED_DOMAINS=columbia.edu

# 서비스 전체가 한 달에 전사할 수 있는 총 분(分). 모든 사용자 합산.
# 600분 ≈ 10시간 ≈ AssemblyAI 기준 약 $2.5, whisper 기준 약 $3.6
MONTHLY_BUDGET_MINUTES=600
